# MCP Bearer Token for API authentication
# Generated automatically by setup.sh in production
MCP_BEARER_TOKEN=your_secret_token_here

# Encryption key for sensitive data
# Generated automatically by setup.sh in production
ENCRYPTION_KEY=your_fernet_key_here

# Strong passphrase for encrypted backups
BACKUP_PASSPHRASE=your_strong_backup_passphrase_here

# Anthropic Claude API key for auto-tagging
# Get from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-...

# Dropbox access token for cloud backup
# Get from https://www.dropbox.com/developers/apps
DROPBOX_ACCESS_TOKEN=sl....

# Domain name for production deployment
DOMAIN=ragbase.yourdomain.com

# Optional: Override paths for development (uncomment and modify as needed)
# DB_PATH=./data/ragbase.db
# UPLOAD_DIR=./uploads
# BACKUP_DIR=./backups
# WHISPER_CACHE=./.whisper_cache
# FAILED_DIR=./failed
# LOG_FILE=./ragbase.log