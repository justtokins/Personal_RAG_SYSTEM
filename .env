# RAGBase environment configuration
# ─────────────────────────────────────────────────────────────────────────────
# AUTO-GENERATED by setup.sh — do not change these unless you know what you're doing:
# ─────────────────────────────────────────────────────────────────────────────

# Bearer token required for all API and MCP requests
MCP_BEARER_TOKEN=your_secret_token_here

# Fernet encryption key for backup files (AES-128-CBC)
# Losing this key makes existing backups unrecoverable — keep a safe copy.
ENCRYPTION_KEY=your_fernet_key_here

# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED — fill these in before starting services:
# ─────────────────────────────────────────────────────────────────────────────

# Your public domain (used by Caddy for TLS certificate provisioning)
DOMAIN=ragbase.yourdomain.com

# Dropbox OAuth credentials for encrypted nightly backups
# Run scripts/dropbox_auth.py on your laptop to generate these:
DROPBOX_APP_KEY=your_dropbox_app_key_here
DROPBOX_APP_SECRET=your_dropbox_app_secret_here
DROPBOX_REFRESH_TOKEN=your_dropbox_refresh_token_here

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — tagging will be skipped if not set:
# ─────────────────────────────────────────────────────────────────────────────

# Anthropic API key for Claude Haiku auto-tagging (~$0.00025/document)
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
