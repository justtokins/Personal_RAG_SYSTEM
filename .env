# RAGBase environment configuration

# Bearer token used by API and MCP auth
MCP_BEARER_TOKEN=your_generated_mcp_bearer_token_here

# Encryption key for backup/data encryption
ENCRYPTION_KEY=your_fernet_key_here

# Passphrase used to encrypt backups
BACKUP_PASSPHRASE=your_strong_backup_passphrase_here

# Optional: Claude Anthropic API key for auto-tagging
ANTHROPIC_API_KEY=sk-ant-...

# Dropbox API credentials for encrypted backup uploads
DROPBOX_APP_KEY=your_dropbox_app_key_here
DROPBOX_APP_SECRET=your_dropbox_app_secret_here
DROPBOX_REFRESH_TOKEN=your_dropbox_refresh_token_here

# Production domain used by Caddy/systemd
DOMAIN=ragbase.yourdomain.com
