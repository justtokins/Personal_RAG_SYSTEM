[Unit]
Description=RAGBase API Server
After=network.target
Wants=network.target

[Service]
Type=simple
User=ragbase
Group=ragbase
WorkingDirectory=/opt/ragbase
EnvironmentFile=/opt/ragbase/.env
ExecStart=/opt/ragbase/venv/bin/python main.py api
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ragbase-api

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/ragbase /var/log/ragbase /home/ragbase/Dropbox

[Install]
WantedBy=multi-user.target
